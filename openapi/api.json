  "info": {
    "description": "Local maintenance definitions, recurring occurrences and completion history. Bearer authentication. Creates, completions and checklist changes require Idempotency-Key; item mutations require the current quoted If-Match revision.",
    "title": "Maintenance API",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
