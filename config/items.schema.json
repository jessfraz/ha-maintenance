{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maintenance import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 200
    }
  },
  "$defs": {
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36600
        },
        "months": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1200
        },
        "years": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "anyOf": [
        {
          "required": [
            "days"
          ],
          "properties": {
            "days": {
              "minimum": 1
            }
          }
        },
        {
          "required": [
            "months"
          ],
          "properties": {
            "months": {
              "minimum": 1
            }
          }
        },
        {
          "required": [
            "years"
          ],
          "properties": {
            "years": {
              "minimum": 1
            }
          }
        }
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 2048
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "timezone",
        "due",
        "schedule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "description": "IANA time zone name."
        },
        "due": {
          "type": "string",
          "format": "date"
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "location": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "group": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "reorder_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 100
        },
        "specs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spec"
          },
          "maxItems": 100
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 100
        }
      }
    }
  }
}
