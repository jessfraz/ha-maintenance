{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maintenance import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 200
    }
  },
  "$defs": {
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36600
        },
        "months": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1200
        },
        "years": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "anyOf": [
        {
          "required": [
            "days"
          ],
          "properties": {
            "days": {
              "minimum": 1
            }
          }
        },
        {
          "required": [
            "months"
          ],
          "properties": {
            "months": {
              "minimum": 1
            }
          }
        },
        {
          "required": [
            "years"
          ],
          "properties": {
            "years": {
              "minimum": 1
            }
          }
        }
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 2048
        }
      }
    },
    "checklistStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S",
          "description": "Nonblank step text. The service also enforces a 200-byte UTF-8 limit."
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "summary",
        "timezone",
        "due",
        "schedule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S",
          "description": "Action title shown for each occurrence, distinct from the item's name. The service also enforces a 200-byte UTF-8 limit."
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 16000,
          "pattern": "\\S",
          "description": "Optional task details; a supplied string must contain non-whitespace text. The service also enforces a 16000-byte UTF-8 limit."
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "description": "IANA time zone name."
        },
        "due": {
          "type": "string",
          "format": "date"
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "location": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "group": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "reorder_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 100
        },
        "checklist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checklistStep"
          },
          "maxItems": 100,
          "uniqueItems": true,
          "default": [],
          "description": "Checklist template. Step IDs must be unique within an item; the service enforces ID uniqueness. Each occurrence receives its own completion state."
        },
        "specs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spec"
          },
          "maxItems": 100
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 100
        }
      }
    }
  }
}
