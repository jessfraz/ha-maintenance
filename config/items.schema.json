{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jessfraz/home-maintenance/config/items.schema.json",
  "title": "Home Maintenance catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "timezone", "todo_entity", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "timezone": { "type": "string", "minLength": 1 },
    "todo_entity": { "type": "string", "pattern": "^todo\\." },
    "due_soon_days": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "ha_summary", "schedule"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "group": { "type": "string" },
        "ha_summary": { "type": "string", "minLength": 1 },
        "ha_description": { "type": "string" },
        "schedule": { "$ref": "#/$defs/schedule" },
        "initial_due": { "type": "string", "format": "date" },
        "reorder_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "instructions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "specs": {
          "type": "array",
          "items": { "$ref": "#/$defs/spec" }
        },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days": { "type": "integer", "minimum": 0 },
        "months": { "type": "integer", "minimum": 0 },
        "years": { "type": "integer", "minimum": 0 }
      },
      "anyOf": [
        { "required": ["days"], "properties": { "days": { "minimum": 1 } } },
        { "required": ["months"], "properties": { "months": { "minimum": 1 } } },
        { "required": ["years"], "properties": { "years": { "minimum": 1 } } }
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    }
  }
}
